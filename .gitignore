cat << 'EOF' > .gitignore
# Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.so

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs & Editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs & Databases
*.log
*.sqlite
*.sqlite3
EOF